GCP_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=/abs/path/to/service-account.json
# Optional alternative to GOOGLE_APPLICATION_CREDENTIALS file path:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Preferred on newer Supabase projects:
# SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_STORAGE_BUCKET=doctor-photos
ADMIN_SESSION_SECRET=replace-with-32-plus-char-secret
ADMIN_KEYS_ENCRYPTION_SECRET=replace-with-another-32-plus-char-secret
AI_GATEWAY_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ADMIN_RATE_LIMIT_MAX=20
ADMIN_RATE_LIMIT_WINDOW_MS=300000
ADMIN_LOCKOUT_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15

# Optional: post-deploy smoke checks
ADMIN_WEB_BASE_URL=https://admin.example.com
ADMIN_SMOKE_USERNAME=admin
ADMIN_SMOKE_PASSWORD=replace-with-smoke-user-password
SMOKE_SKIP_FIRESTORE=0
