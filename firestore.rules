rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    function isThreadAuthor() {
      return isAuthed() && resource.data.authorUid == request.auth.uid;
    }

    function validUserProfileWrite(uid) {
      return isOwner(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.nickname is string &&
        request.resource.data.nickname.size() > 0 &&
        request.resource.data.nickname.size() <= 40 &&
        request.resource.data.nicknameKey is string &&
        request.resource.data.nicknameKey.size() > 0 &&
        request.resource.data.nicknameKey.size() <= 40 &&
        request.resource.data.isGuest is bool &&
        (
          resource == null ||
          request.resource.data.createdAt == resource.data.createdAt
        ) &&
        request.resource.data.keys().hasOnly([
          'uid',
          'nickname',
          'nicknameKey',
          'isGuest',
          'createdAt',
          'updatedAt'
        ]);
    }

    function validNicknameClaimWrite(nicknameKey) {
      return isAuthed() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.nicknameKey == nicknameKey &&
        request.resource.data.nickname is string &&
        request.resource.data.nickname.size() > 0 &&
        request.resource.data.nickname.size() <= 40 &&
        request.resource.data.keys().hasOnly([
          'uid',
          'nickname',
          'nicknameKey',
          'updatedAt'
        ]);
    }

    function canAuthorEditThreadContentOnly() {
      return isThreadAuthor() &&
        request.resource.data.authorUid == resource.data.authorUid &&
        request.resource.data.author == resource.data.author &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.replyCount == resource.data.replyCount &&
        request.resource.data.title == resource.data.title &&
        request.resource.data.isHidden == resource.data.isHidden &&
        request.resource.data.isFlagged == resource.data.isFlagged &&
        request.resource.data.moderationNote == resource.data.moderationNote &&
        request.resource.data.moderatedAt == resource.data.moderatedAt &&
        request.resource.data.moderatedBy == resource.data.moderatedBy &&
        request.resource.data.body is string &&
        request.resource.data.edited == true;
    }

    function canIncrementReplyCountOnly() {
      return isAuthed() &&
        request.resource.data.authorUid == resource.data.authorUid &&
        request.resource.data.author == resource.data.author &&
        request.resource.data.title == resource.data.title &&
        request.resource.data.body == resource.data.body &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.edited == resource.data.edited &&
        request.resource.data.isHidden == resource.data.isHidden &&
        request.resource.data.isFlagged == resource.data.isFlagged &&
        request.resource.data.moderationNote == resource.data.moderationNote &&
        request.resource.data.moderatedAt == resource.data.moderatedAt &&
        request.resource.data.moderatedBy == resource.data.moderatedBy &&
        (
          request.resource.data.replyCount == resource.data.replyCount + 1 ||
          request.resource.data.replyCount == resource.data.replyCount - 1
        );
    }

    function canAuthorEditReplyContentOnly(threadId) {
      return isAuthed() &&
        resource.data.authorUid == request.auth.uid &&
        request.resource.data.threadId == threadId &&
        request.resource.data.authorUid == resource.data.authorUid &&
        request.resource.data.author == resource.data.author &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.isHidden == resource.data.isHidden &&
        request.resource.data.isFlagged == resource.data.isFlagged &&
        request.resource.data.moderationNote == resource.data.moderationNote &&
        request.resource.data.moderatedAt == resource.data.moderatedAt &&
        request.resource.data.moderatedBy == resource.data.moderatedBy &&
        request.resource.data.body is string &&
        request.resource.data.edited == true &&
        request.resource.data.keys().hasOnly([
          'threadId',
          'body',
          'author',
          'authorUid',
          'createdAt',
          'edited',
          'isHidden',
          'isFlagged',
          'moderationNote',
          'moderatedAt',
          'moderatedBy'
        ]);
    }

    function isValidMoodId(moodId) {
      return moodId in ['great', 'good', 'okay', 'bad', 'terrible'];
    }

    function isValidAppointmentStatus(status) {
      return status in ['requested', 'confirmed', 'completed', 'cancelled'];
    }

    function validMoodLogWrite(uid, dateKey) {
      return isOwner(uid) &&
        dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        request.resource.data.uid == uid &&
        request.resource.data.dateKey == dateKey &&
        request.resource.data.date is timestamp &&
        request.resource.data.moodId is string &&
        isValidMoodId(request.resource.data.moodId) &&
        request.resource.data.moodScore is int &&
        request.resource.data.moodScore >= 1 &&
        request.resource.data.moodScore <= 5 &&
        request.resource.data.note is string &&
        request.resource.data.note.size() <= 500 &&
        request.resource.data.noteLength is int &&
        request.resource.data.noteLength >= 0 &&
        request.resource.data.noteLength <= 500 &&
        request.resource.data.source is string &&
        request.resource.data.source.size() > 0 &&
        request.resource.data.source.size() <= 40 &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.keys().hasOnly([
          'uid',
          'dateKey',
          'date',
          'moodId',
          'moodScore',
          'note',
          'noteLength',
          'source',
          'createdAt',
          'updatedAt'
        ]);
    }

    function validAppointmentCreate() {
      return isAuthed() &&
        request.resource.data.userUid == request.auth.uid &&
        request.resource.data.userNickname is string &&
        request.resource.data.userNickname.size() <= 80 &&
        request.resource.data.doctorId is string &&
        request.resource.data.doctorId.size() > 0 &&
        request.resource.data.doctorId.size() <= 160 &&
        request.resource.data.doctorName is string &&
        request.resource.data.doctorName.size() > 0 &&
        request.resource.data.doctorName.size() <= 120 &&
        request.resource.data.doctorSpecialization is string &&
        request.resource.data.doctorSpecialization.size() > 0 &&
        request.resource.data.doctorSpecialization.size() <= 120 &&
        request.resource.data.preferredDate is timestamp &&
        request.resource.data.issueSummary is string &&
        request.resource.data.issueSummary.size() > 0 &&
        request.resource.data.issueSummary.size() <= 500 &&
        request.resource.data.preferredLocation is string &&
        request.resource.data.preferredLocation.size() <= 160 &&
        request.resource.data.onlineMeetingLink is string &&
        request.resource.data.onlineMeetingLink.size() <= 300 &&
        request.resource.data.note is string &&
        request.resource.data.note.size() <= 500 &&
        request.resource.data.status == 'requested' &&
        request.resource.data.adminNote is string &&
        request.resource.data.adminNote.size() == 0 &&
        request.resource.data.requestSource is string &&
        request.resource.data.requestSource.size() > 0 &&
        request.resource.data.requestSource.size() <= 40 &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.keys().hasOnly([
          'userUid',
          'userNickname',
          'doctorId',
          'doctorName',
          'doctorSpecialization',
          'preferredDate',
          'issueSummary',
          'preferredLocation',
          'onlineMeetingLink',
          'note',
          'status',
          'adminNote',
          'requestSource',
          'createdAt',
          'updatedAt'
        ]);
    }

    // User profile: users can only read/write their own profile doc.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if validUserProfileWrite(uid);
      allow delete: if isOwner(uid);
    }

    // Nickname uniqueness lock docs keyed by normalized nickname.
    match /nickname_claims/{nicknameKey} {
      allow read: if isAuthed();
      allow create, update: if validNicknameClaimWrite(nicknameKey) &&
        (
          !exists(/databases/$(database)/documents/nickname_claims/$(nicknameKey)) ||
          resource.data.uid == request.auth.uid
        );
      allow delete: if isAuthed() && resource.data.uid == request.auth.uid;
    }

    match /threads/{threadId} {
      allow read: if isAuthed() && resource.data.isHidden != true;
      allow create: if isAuthed() &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.author is string &&
        request.resource.data.body is string &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.replyCount is int &&
        request.resource.data.edited is bool &&
        (
          !request.resource.data.keys().hasAny(['isHidden']) ||
          request.resource.data.isHidden == false
        ) &&
        (
          !request.resource.data.keys().hasAny(['isFlagged']) ||
          request.resource.data.isFlagged == false
        ) &&
        !request.resource.data.keys().hasAny([
          'moderationNote',
          'moderatedAt',
          'moderatedBy'
        ]) &&
        request.resource.data.keys().hasOnly([
          'title',
          'body',
          'author',
          'authorUid',
          'createdAt',
          'replyCount',
          'edited',
          'isHidden',
          'isFlagged'
        ]);
      allow update: if canAuthorEditThreadContentOnly() || canIncrementReplyCountOnly();
      allow delete: if isThreadAuthor();

      match /replies/{replyId} {
        allow read: if isAuthed() && resource.data.isHidden != true;
        allow create: if isAuthed() &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.threadId == threadId &&
          request.resource.data.author is string &&
          request.resource.data.body is string &&
          request.resource.data.createdAt is timestamp &&
          request.resource.data.edited is bool &&
          (
            !request.resource.data.keys().hasAny(['isHidden']) ||
            request.resource.data.isHidden == false
          ) &&
          (
            !request.resource.data.keys().hasAny(['isFlagged']) ||
            request.resource.data.isFlagged == false
          ) &&
          !request.resource.data.keys().hasAny([
            'moderationNote',
            'moderatedAt',
            'moderatedBy'
          ]) &&
          request.resource.data.keys().hasOnly([
            'threadId',
            'body',
            'author',
            'authorUid',
            'createdAt',
            'edited',
            'isHidden',
            'isFlagged'
          ]);
        allow update: if canAuthorEditReplyContentOnly(threadId);
        allow delete: if isAuthed() && resource.data.authorUid == request.auth.uid;
      }
    }

    // Per-user mood tracking (one log per day key).
    match /user_moods/{uid}/mood_logs/{dateKey} {
      allow read: if isOwner(uid);
      allow create, update: if validMoodLogWrite(uid, dateKey);
      allow delete: if isOwner(uid);
    }

    // Therapist directory is managed by admin backend.
    match /doctors/{doctorId} {
      allow read: if isAuthed() && resource.data.isActive == true;
      allow write: if false;
    }

    // Appointment requests are created/read by the owner user only.
    match /appointments/{appointmentId} {
      allow read: if isAuthed() && resource.data.userUid == request.auth.uid;
      allow create: if validAppointmentCreate();
      allow update, delete: if false;
    }

    // Admin + AI backend collections are server-only.
    match /app_config/{docId} {
      allow read, write: if false;
    }

    match /content_emergency_numbers/{docId} {
      allow read, write: if false;
    }

    match /content_tools/{docId} {
      allow read, write: if false;
    }

    match /content_therapist_subscriptions/{docId} {
      allow read, write: if false;
    }

    match /content_legal/{docId} {
      allow read, write: if false;
    }

    match /admin_auth/{docId} {
      allow read, write: if false;
    }

    match /admin_audit_logs/{docId} {
      allow read, write: if false;
    }

    match /ai_request_logs/{docId} {
      allow read, write: if false;
    }

    match /ai_metrics_daily/{docId} {
      allow read, write: if false;
    }

    match /mood_metrics_daily/{docId} {
      allow read, write: if false;
    }

    // Default deny for anything not explicitly covered.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
